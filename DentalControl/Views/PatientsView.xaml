<UserControl x:Class="DentalControl.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:DentalControl.Infrastructure.Converters"
             x:Name="PatientsRoot" Language="es-GT"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:PatientFullNameConverter x:Key="PatientFullName" />
            <Style x:Key="PatientCellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PatientActionButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource SidebarButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#EAF0FB" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientPrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PatientActionButtonStyle}">
                <Setter Property="Background" Value="#2D4FA3" />
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#244082" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Padding" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="PatientValidationControlStyle" TargetType="Control">
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="#B91C1C" />
                        <Setter Property="Background" Value="#FEF2F2" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientTextInputStyle" TargetType="TextBox"
                   BasedOn="{StaticResource PatientValidationControlStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#1E293B" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border CornerRadius="10" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            <Condition Property="Validation.HasError" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#2D4FA3" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientRoundedFieldFrameStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#2D4FA3" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="BorderBrush" Value="#B91C1C" />
                        <Setter Property="Background" Value="#FEF2F2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientFieldErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B91C1C" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Text" Value="{Binding Tag.(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientMessageStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="SuccessText" Text="{Binding SuccessMessage}"
                       Style="{StaticResource PatientMessageStyle}" Foreground="#15803D" />
        </StackPanel>

        <Border x:Name="PatientListCard" Grid.Row="1" Background="White" CornerRadius="12" Padding="24"
                Visibility="{Binding IsEntryVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Pacientes" FontSize="24" FontWeight="SemiBold"
                           Foreground="#2D4FA3" Margin="0,0,0,20" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Buscar paciente" Target="{Binding ElementName=PatientSearchInput}" />
                        <TextBox x:Name="PatientSearchInput" Style="{StaticResource PatientTextInputStyle}"
                                 ToolTip="Nombre, apellido, DPI / CUI o código. La búsqueda ignora tildes."
                                 Text="{Binding List.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Estado" Target="{Binding ElementName=PatientStatusInput}" />
                        <Border Style="{StaticResource PatientRoundedFieldFrameStyle}"
                                Tag="{Binding ElementName=PatientStatusInput}">
                            <ComboBox x:Name="PatientStatusInput" MinHeight="32" Padding="8"
                                      BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding List.StatusOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding List.SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="NewPatientButton" Grid.Column="4" Content="Nuevo paciente"
                            Command="{Binding NewPatientCommand}" Style="{StaticResource PatientPrimaryButtonStyle}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,20,0,20" MinHeight="180">
                    <DataGrid x:Name="PatientTable" ItemsSource="{Binding List.Patients}"
                              Visibility="{Binding List.HasPatients, Converter={StaticResource BoolToVisibility}}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                              RowHeight="46" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E293B" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EFF6FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B" />
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EAF0FB" />
                                <Setter Property="Foreground" Value="#2D4FA3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,12" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="Foreground" Value="#1E293B" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Width="135" Binding="{Binding PatientCode}"
                                                ElementStyle="{StaticResource PatientCellTextStyle}" />
                            <DataGridTextColumn Header="Nombre completo" Width="*" MinWidth="180"
                                                ElementStyle="{StaticResource PatientCellTextStyle}">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource PatientFullName}">
                                        <Binding Path="FirstName" />
                                        <Binding Path="MiddleName" />
                                        <Binding Path="LastName" />
                                        <Binding Path="SecondLastName" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DPI / CUI" Width="150" Binding="{Binding Cui, TargetNullValue=—}"
                                                ElementStyle="{StaticResource PatientCellTextStyle}" />
                            <DataGridTextColumn Header="Teléfono" Width="125" Binding="{Binding Phone, TargetNullValue=—}"
                                                ElementStyle="{StaticResource PatientCellTextStyle}" />
                            <DataGridTemplateColumn Header="Estado" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Activo" />
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="I">
                                                            <Setter Property="Text" Value="Inactivo" />
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Acción" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ver expediente" IsEnabled="False" MinHeight="32" Padding="10,6"
                                                Style="{StaticResource PatientActionButtonStyle}"
                                                ToolTipService.ShowOnDisabled="True" ToolTip="El expediente todavía no está disponible." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding List.IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Cargando pacientes…" Foreground="#64748B" TextAlignment="Center" />
                        <ProgressBar IsIndeterminate="True" Height="3" Width="180" Margin="0,12,0,0" Foreground="#2D4FA3" />
                    </StackPanel>
                    <TextBlock Text="{Binding List.EmptyMessage}" Foreground="#64748B" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding List.ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding List.HasLoadError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding List.LoadErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"
                                   MaxWidth="400" TextAlignment="Center" />
                        <Button Content="Reintentar" Command="{Binding List.RefreshCommand}"
                                Style="{StaticResource PatientActionButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Anterior" Command="{Binding List.PreviousPageCommand}"
                            Style="{StaticResource PatientActionButtonStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding List.PageSummary}" Foreground="#64748B" TextWrapping="Wrap"
                               VerticalAlignment="Center" TextAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="2" Content="Siguiente" Command="{Binding List.NextPageCommand}"
                            Style="{StaticResource PatientActionButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="RegistrationForm" Grid.Row="1"
                Background="White" CornerRadius="12" Padding="24" VerticalAlignment="Top"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Nuevo paciente" FontSize="24" FontWeight="SemiBold" Foreground="#2D4FA3" />
                    <TextBlock Text="Los campos con * son obligatorios." Foreground="#64748B" Margin="0,8,0,20" />
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding IsLoadingGenders, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Cargando géneros…" Foreground="#64748B" Margin="0,0,0,8" />
                        <ProgressBar IsIndeterminate="True" Height="3" Foreground="#2D4FA3" />
                    </StackPanel>

                    <Grid x:Name="FormFields" IsEnabled="{Binding CanEdit}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <Label Content="Primer nombre *" Target="{Binding ElementName=FirstNameInput}" />
                            <TextBox x:Name="FirstNameInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=FirstNameInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <Label Content="Segundo nombre" Target="{Binding ElementName=MiddleNameInput}" />
                            <TextBox x:Name="MiddleNameInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=MiddleNameInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <Label Content="Primer apellido *" Target="{Binding ElementName=LastNameInput}" />
                            <TextBox x:Name="LastNameInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=LastNameInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                            <Label Content="Segundo apellido" Target="{Binding ElementName=SecondLastNameInput}" />
                            <TextBox x:Name="SecondLastNameInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding SecondLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=SecondLastNameInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                            <Label Content="Fecha de nacimiento *" Target="{Binding ElementName=BirthDateInput}" />
                            <Border Style="{StaticResource PatientRoundedFieldFrameStyle}"
                                    Tag="{Binding ElementName=BirthDateInput}">
                                <DatePicker x:Name="BirthDateInput" MinHeight="32" Padding="4"
                                        BorderThickness="0" Background="Transparent"
                                        Style="{StaticResource PatientValidationControlStyle}" SelectedDateFormat="Short"
                                        SelectedDate="{Binding BirthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            </Border>
                            <TextBlock Tag="{Binding ElementName=BirthDateInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                            <Label Content="Género *" Target="{Binding ElementName=GenderInput}" />
                            <Border Style="{StaticResource PatientRoundedFieldFrameStyle}"
                                    Tag="{Binding ElementName=GenderInput}">
                                <ComboBox x:Name="GenderInput" MinHeight="32" Padding="8"
                                      BorderThickness="0" Background="Transparent"
                                      Style="{StaticResource PatientValidationControlStyle}" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Genders}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedGender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            </Border>
                            <TextBlock Tag="{Binding ElementName=GenderInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                            <Label Content="DPI / CUI (opcional)" Target="{Binding ElementName=CuiInput}" />
                            <TextBox x:Name="CuiInput" MaxLength="13"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding Cui, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=CuiInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                            <Label Content="Teléfono" Target="{Binding ElementName=PhoneInput}" />
                            <TextBox x:Name="PhoneInput" MaxLength="20"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=PhoneInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                            <Label Content="Ocupación" Target="{Binding ElementName=OccupationInput}" />
                            <TextBox x:Name="OccupationInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding Occupation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=OccupationInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                            <Label Content="Referido por" Target="{Binding ElementName=ReferredByInput}" />
                            <TextBox x:Name="ReferredByInput" MaxLength="100"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding ReferredBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=ReferredByInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,24">
                            <Label Content="Dirección" Target="{Binding ElementName=AddressInput}" />
                            <TextBox x:Name="AddressInput" MaxLength="500" MinHeight="72"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource PatientTextInputStyle}"
                                     Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Tag="{Binding ElementName=AddressInput}" Style="{StaticResource PatientFieldErrorStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Text="{Binding FormErrorMessage}"
                               Style="{StaticResource PatientMessageStyle}" Foreground="#B91C1C" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelPatientButton" Content="Cancelar" Command="{Binding CancelCommand}"
                                Style="{StaticResource PatientActionButtonStyle}" Margin="0,0,12,0" />
                        <Button x:Name="SavePatientButton" Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}" IsDefault="{Binding IsFormOpen}"
                                Style="{StaticResource PatientPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Popup x:Name="DuplicateCuiPopup" Grid.RowSpan="2"
               IsOpen="{Binding IsDuplicateCuiPopupOpen, Mode=TwoWay}"
               Placement="Center" PlacementTarget="{Binding ElementName=PatientsRoot}"
               StaysOpen="False" AllowsTransparency="True" Focusable="True"
               Opened="DuplicateCuiPopup_Opened" Closed="DuplicateCuiPopup_Closed">
            <Border Width="380" Padding="24" CornerRadius="12"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                <Border.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CloseDuplicateCuiPopupCommand}" />
                </Border.InputBindings>
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="DPI / CUI duplicado" FontSize="18" FontWeight="SemiBold"
                               Foreground="#B91C1C" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <Button x:Name="AcceptDuplicateCuiButton" Content="Aceptar"
                            Command="{Binding CloseDuplicateCuiPopupCommand}"
                            Style="{StaticResource PatientActionButtonStyle}"
                            Background="#B91C1C" Foreground="White"
                            HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
