<UserControl x:Class="DentalControl.Views.PatientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DentalControl.Views" Language="es-GT">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/PatientFields.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PatientDetailValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#1E293B" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PatientDetailLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
            <Style x:Key="DetailFieldGroup" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="16,10" Margin="0,0,8,12">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF0FB" />
                                    <Setter Property="Foreground" Value="#2D4FA3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="PatientReadOnlyTemplate">
                    <Border Background="White" CornerRadius="12" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Background="#EAF0FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                        <TextBlock Text="Información básica" Foreground="#2D4FA3" FontWeight="SemiBold" />
                                    </Border>
                                    <UniformGrid Columns="2">
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Primer nombre" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.FirstName, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Segundo nombre" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.MiddleName, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Primer apellido" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.LastName, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Segundo apellido" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.SecondLastName, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Fecha de nacimiento" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.BirthDateText, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Edad" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.AgeText, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Género" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.GenderName, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="DPI / CUI" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.Cui, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Background="#EAF0FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                        <TextBlock Text="Información de contacto" Foreground="#2D4FA3" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Teléfono" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.Phone, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Dirección" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.Address, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <Border Background="#EAF0FB" CornerRadius="6" Padding="10,8" Margin="0,12,0,16">
                                        <TextBlock Text="Información adicional" Foreground="#2D4FA3" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Ocupación" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.Occupation, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DetailFieldGroup}">
                                        <TextBlock Text="Referido por" Style="{StaticResource PatientDetailLabelStyle}" /><TextBlock Text="{Binding Detail.ReferredBy, Mode=OneWay}" Style="{StaticResource PatientDetailValueStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="#EAF0FB" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="Editar datos" Command="{Binding EditPatientCommand}"
                                                Style="{StaticResource PatientActionButtonStyle}" Margin="0,0,8,0" />
                                        <Button Content="{Binding StatusActionText}" Command="{Binding ChangePatientStatusCommand}"
                                                Visibility="{Binding CanManagePatientStatus, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PatientActionButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail.Patient.Status}" Value="A">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding StatusChangeErrorMessage}" Foreground="#B91C1C"
                                               Style="{StaticResource PatientMessageStyle}" MaxWidth="400" TextWrapping="Wrap"
                                               HorizontalAlignment="Right" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Content="← Volver a pacientes" Command="{Binding BackToListCommand}"
                Style="{StaticResource SidebarButtonStyle}" Padding="0,8" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24"
                Visibility="{Binding Detail.HasPatient, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" Background="#EAF0FB" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.Initials}" FontSize="19" FontWeight="SemiBold"
                               Foreground="#2D4FA3" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Detail.FullName}" FontSize="22" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap" />
                    <TextBlock Foreground="#64748B" Margin="0,5,0,0">
                        <Run Text="{Binding Detail.PatientCode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail.StatusText, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6" ToolTip="DPI / CUI">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Data="M1,3 L19,3 L19,17 L1,17 Z M4,8 A2,2 0 1 0 8,8 A2,2 0 1 0 4,8 M3,14 C3,10 9,10 9,14 M12,7 L16,7 M12,11 L16,11" />
                            <TextBlock Text="{Binding Detail.HeaderCui}" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6" ToolTip="Edad">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Data="M1,4 L17,4 L17,18 L1,18 Z M1,8 L17,8 M5,1 L5,6 M13,1 L13,6 M5,11 L7,11 M11,11 L13,11 M5,15 L7,15" />
                            <TextBlock Text="{Binding Detail.AgeText}" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Género">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0"
                                  Data="M8,1 A3,3 0 1 0 8,7 A3,3 0 1 0 8,1 M1,16 L1,14 C1,8 15,8 15,14 L15,16 Z" />
                            <TextBlock Text="{Binding Detail.GenderName}" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Cargando datos del paciente…" Foreground="#64748B" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Foreground="#2D4FA3" />
            </StackPanel>
            <TextBlock Text="El paciente no existe o ya no está disponible." TextWrapping="Wrap" Foreground="#64748B"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Detail.IsNotFound, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Detail.HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Detail.ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" />
                <Button Content="Reintentar" Command="{Binding Detail.RetryCommand}" HorizontalAlignment="Center"
                        Style="{StaticResource PatientActionButtonStyle}" Margin="0,16,0,0" />
            </StackPanel>
            <TabControl Background="Transparent" BorderThickness="0"
                        Visibility="{Binding Detail.HasPatient, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="Datos personales">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource PatientReadOnlyTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate><views:PatientFormView /></DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
