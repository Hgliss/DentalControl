<Window x:Class="DentalControl.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DentalControl | Iniciar sesión"
        Width="900"
        Height="620"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Montserrat">


    <Border Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24"
            Padding="24"
            Background="White"
            CornerRadius="12">
        <StackPanel>
            <TextBlock Text="DentalControl"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#2D4FA3"
                    TextAlignment="Center"
            />

            <TextBlock Text="Sistema de Gestión Clínica"
                       Margin="0,8,0,24"
                       FontWeight="Medium"
                       FontSize="14"
                       Foreground="#4DB6E2"
                       TextAlignment="Center"/>

            <TextBlock Text="Usuario"
                       Margin="0,0,0,6"
                       FontWeight="Medium"/>

           
            <Border BorderBrush="#DDE6ED"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="White">

                <TextBox x:Name="UsernameInput"
                     Height="36"
                     Padding="8"
                     MaxLength="50"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"/>
            </Border>

            <TextBlock Text="Contraseña"
                       Margin="0,16,0,6"
                       FontWeight="Medium"/>

            <Border BorderBrush="#DDE6ED"
        BorderThickness="1"
        CornerRadius="8"
        Background="White">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PasswordInput"
                     Grid.Column="0"
                     Height="36"
                     Padding="8,0"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"/>

                    <TextBox x:Name="VisiblePasswordInput"
                             Grid.Column="0"
                             Height="36"
                             Padding="8,0"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"
                             TextChanged="VisiblePasswordInput_TextChanged"/>

                    <Button x:Name="TogglePasswordButton"
                            Grid.Column="1"
                            Content="👁"
                            FontFamily="Segoe UI Emoji"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Mostrar contraseña"
                            AutomationProperties.Name="Mostrar contraseña"
                            Click="TogglePasswordButton_Click"/>
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       Foreground="#B91C1C"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>

            <Button x:Name="LoginButton"
                    Content="Ingresar"
                    Height="36"
                    Margin="0,18,0,0"
                    Background="#2D4FA3"
                    Foreground="White"
                    IsDefault="True"
                    Click="LoginButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="8">
                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>