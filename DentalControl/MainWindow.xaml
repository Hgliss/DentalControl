<Window x:Class="DentalControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DentalControl.Infrastructure.Converters"
        xmlns:nav="clr-namespace:DentalControl.ViewModels.Navigation"
        xmlns:home="clr-namespace:DentalControl.ViewModels.Home"
        xmlns:patients="clr-namespace:DentalControl.ViewModels.Patients"
        xmlns:payments="clr-namespace:DentalControl.ViewModels.Payments"
        xmlns:reports="clr-namespace:DentalControl.ViewModels.Reports"
        xmlns:administration="clr-namespace:DentalControl.ViewModels.Administration"
        xmlns:views="clr-namespace:DentalControl.Views"
        Title="DentalControl"
        Width="900"
        Height="620"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Montserrat"
        Background="#F3F6FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:ValuesEqualConverter x:Key="ValuesEqualConverter" />
            <DataTemplate DataType="{x:Type home:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type patients:PatientsViewModel}">
                <views:PatientsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type payments:PaymentsViewModel}">
                <views:PaymentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type administration:AdministrationViewModel}">
                <views:AdministrationView />
            </DataTemplate>
            <Style x:Key="NavigationButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource SidebarButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource ValuesEqualConverter}">
                                <Binding Path="SelectedScreen" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="#EAF0FB" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                Padding="20"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DentalControl"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2D4FA3" />

                <ScrollViewer Grid.Row="1"
                              Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Button x:Name="HomeButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Tag="{x:Static nav:Screen.Home}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static nav:Screen.Home}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,8 L8,1 L16,8 M3,7 L3,16 L7,16 L7,11 L10,11 L10,16 L14,16 L14,7"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#2D4FA3"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                            <TextBlock Text="Inicio"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PatientsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0,8,0,0"
                            Tag="{x:Static nav:Screen.Patients}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static nav:Screen.Patients}">

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M11,4 A3,3 0 1 1 5,4 A3,3 0 1 1 11,4
                                    M1,16 L1,14 C1,8 15,8 15,14 L15,16 Z"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#2D4FA3"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                            <TextBlock Text="Pacientes"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PaymentsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0,8,0,0"
                            Tag="{x:Static nav:Screen.Payments}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static nav:Screen.Payments}">

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,2 L17,2 L17,14 L1,14 Z M1,6 L17,6 M4,11 L8,11"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#2D4FA3"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                            <TextBlock Text="Cargos y pagos"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReportsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0,8,0,0"
                            Tag="{x:Static nav:Screen.Reports}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static nav:Screen.Reports}">

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,0 L1,16 L17,16 M5,12 L5,8 M9,12 L9,4 M13,12 L13,1"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#2D4FA3"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                            <TextBlock Text="Reportes"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AdministrationButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0,8,0,0"
                            Visibility="{Binding CanAccessAdministration, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Tag="{x:Static nav:Screen.Administration}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static nav:Screen.Administration}">

                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,4 L16,4 M0,12 L16,12
                                        M7,4 A2,2 0 1 1 3,4 A2,2 0 1 1 7,4
                                        M13,12 A2,2 0 1 1 9,12 A2,2 0 1 1 13,12"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="#2D4FA3"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                            <TextBlock Text="Administración"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           x:Name="WelcomeText"
                           Text="{Binding WelcomeText}"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Foreground="#64748B" />
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="Cerrar sesión"
                    Style="{StaticResource SidebarButtonStyle}"
                    Padding="18,10"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    Background="#EAF0FB"
                    FontSize="13"
                    FontWeight="Medium"
                    Command="{Binding LogoutCommand}" />

            <ContentControl x:Name="MainContent"
                            Content="{Binding CurrentViewModel}"
                            Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
