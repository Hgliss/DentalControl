<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:DentalControl.Infrastructure.Converters">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:PatientFullNameConverter x:Key="PatientFullName" />
            <Style x:Key="PatientCellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PatientActionButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource SidebarButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#EAF0FB" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientPrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PatientActionButtonStyle}">
                <Setter Property="Background" Value="#2D4FA3" />
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#244082" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Padding" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="PatientValidationControlStyle" TargetType="Control">
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="#B91C1C" />
                        <Setter Property="Background" Value="#FEF2F2" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientTextInputStyle" TargetType="TextBox"
                   BasedOn="{StaticResource PatientValidationControlStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#1E293B" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border CornerRadius="10" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            <Condition Property="Validation.HasError" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#2D4FA3" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientRoundedFieldFrameStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DDE6ED" />
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Tag.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                            <Condition Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#2D4FA3" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="BorderBrush" Value="#B91C1C" />
                        <Setter Property="Background" Value="#FEF2F2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientFieldErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B91C1C" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Text" Value="{Binding Tag.(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PatientMessageStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        
</ResourceDictionary>
